rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /faces/{studentId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      allow write: if request.auth != null && request.auth.uid == studentId;
    }

    match /notes/{classroomId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /assignments/{classroomId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /submissions/{assignmentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /questionBank/{classroomId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
