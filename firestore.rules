rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated() && (
        (userDocExists() && getUserData().get('role', '') in ['teacher', 'Teacher'])
        || ((!userDocExists() || !('role' in getUserData()))
          && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)))
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        (userDocExists() && getUserData().get('role', '') in ['student', 'Student'])
        || ((!userDocExists() || !('role' in getUserData()))
          && exists(/databases/$(database)/documents/students/$(request.auth.uid)))
      );
    }

    function classroomExists(classroomId) {
      return classroomId is string
        && exists(/databases/$(database)/documents/classrooms/$(classroomId));
    }

    function classroomData(classroomId) {
      return get(/databases/$(database)/documents/classrooms/$(classroomId)).data;
    }

    function ownsClassroom(classroomId) {
      return isAuthenticated()
        && classroomExists(classroomId)
        && classroomData(classroomId).teacherId == request.auth.uid;
    }

    function isEnrolled(classroomId) {
      return isAuthenticated()
        && classroomExists(classroomId)
        && classroomData(classroomId).get('studentIds', []).hasAny([request.auth.uid]);
    }

    function sessionExists(sessionId) {
      return sessionId is string
        && exists(/databases/$(database)/documents/attendanceSessions/$(sessionId));
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data;
    }

    function assignmentExists(assignmentId) {
      return assignmentId is string
        && exists(/databases/$(database)/documents/assignments/$(assignmentId));
    }

    function assignmentData(assignmentId) {
      return get(/databases/$(database)/documents/assignments/$(assignmentId)).data;
    }

    // ─── USERS COLLECTION ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
    }

    // ─── TEACHERS COLLECTION ─────────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId) || isTeacher();
    }

    // ─── STUDENTS COLLECTION ─────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(studentId);
      allow update, delete: if isOwner(studentId) || isStudent();
    }

    // ─── CLASSROOMS COLLECTION ───────────────────────────────────────────────
    match /classrooms/{classroomId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if resource.data.teacherId == request.auth.uid
        || (isStudent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds', 'updatedAt'])
          && request.resource.data.studentIds.hasAll(resource.data.get('studentIds', []))
          && request.resource.data.studentIds.size() == resource.data.get('studentIds', []).size() + 1
          && request.resource.data.studentIds.hasAny([request.auth.uid]));
      allow delete: if isAuthenticated() && resource.data.teacherId == request.auth.uid;
    }

    // ─── ATTENDANCE SESSIONS ─────────────────────────────────────────────────
    match /attendanceSessions/{sessionId} {
      // get: single-doc read (resource is the doc or null for existence check)
      allow get: if isAuthenticated() && (
        resource == null
        || resource.data.teacherId == request.auth.uid
        || ownsClassroom(resource.data.classroomId)
        || isEnrolled(resource.data.classroomId)
      );
      // list: resource.data is NOT available for collection-level queries in Firestore rules.
      // Data isolation is enforced by the application-layer where('classroomId','==',uid) filters.
      allow list: if isAuthenticated();
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && ownsClassroom(request.resource.data.classroomId)
        && request.resource.data.status == 'active'
        && request.resource.data.startTime < request.resource.data.endTime;
      allow update: if (ownsClassroom(resource.data.classroomId)
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.classroomId == resource.data.classroomId)
        || (isEnrolled(resource.data.classroomId)
          && request.resource.data.status == 'ended'
          && resource.data.endTime <= request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'updatedAt']));
      allow delete: if ownsClassroom(resource.data.classroomId);
    }

    // ─── ATTENDANCE RECORDS ──────────────────────────────────────────────────
    match /attendance/{attendanceId} {
      // get: single-doc read (resource == null for existence checks before creation)
      allow get: if isAuthenticated() && (
        resource == null
        || resource.data.studentId == request.auth.uid
        || resource.data.teacherId == request.auth.uid
        || ownsClassroom(resource.data.classroomId)
        || isEnrolled(resource.data.classroomId)
      );
      // list: resource.data is NOT available for collection-level queries.
      // Application always filters by classroomId/sessionId/studentId.
      allow list: if isAuthenticated();
      allow create: if (isAuthenticated()
          && request.resource.data.studentId == request.auth.uid
          && isEnrolled(request.resource.data.classroomId)
          && sessionExists(request.resource.data.sessionId)
          && sessionData(request.resource.data.sessionId).classroomId == request.resource.data.classroomId
          && sessionData(request.resource.data.sessionId).teacherId == request.resource.data.teacherId
          && sessionData(request.resource.data.sessionId).status in ['active', 'reopened']
          && sessionData(request.resource.data.sessionId).startTime <= request.time + duration.value(5, 'm')
          && sessionData(request.resource.data.sessionId).endTime > request.time - duration.value(1, 'm')
          && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid)
        || (ownsClassroom(request.resource.data.classroomId)
          && request.resource.data.teacherId == request.auth.uid
          && sessionExists(request.resource.data.sessionId)
          && sessionData(request.resource.data.sessionId).classroomId == request.resource.data.classroomId
          && attendanceId == request.resource.data.sessionId + '_' + request.resource.data.studentId);
      allow update: if ownsClassroom(resource.data.classroomId)
        && request.resource.data.classroomId == resource.data.classroomId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.teacherId == request.auth.uid;
      allow delete: if ownsClassroom(resource.data.classroomId);
    }

    // ─── BIOMETRIC FACE DATA ─────────────────────────────────────────────────
    match /faceData/{studentId} {
      allow read: if isOwner(studentId);
      allow create: if isOwner(studentId)
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.template.sampleCount == 3;
      allow update: if isOwner(studentId)
        && request.resource.data.studentId == request.auth.uid;
      allow delete: if isOwner(studentId);
    }

    // ─── NOTES ───────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─── ASSIGNMENTS ─────────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow get: if isAuthenticated() && (
        resource == null
        || resource.data.teacherId == request.auth.uid
        || ownsClassroom(resource.data.classroomId)
        || isEnrolled(resource.data.classroomId)
      );
      // list: resource.data is NOT available for collection-level queries.
      allow list: if isAuthenticated();
      allow create: if (isTeacher() || ownsClassroom(request.resource.data.classroomId))
        && request.resource.data.teacherId == request.auth.uid
        && ownsClassroom(request.resource.data.classroomId);
      allow update: if ownsClassroom(resource.data.classroomId)
        && request.resource.data.classroomId == resource.data.classroomId
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if ownsClassroom(resource.data.classroomId);
    }

    // ─── SUBMISSIONS ─────────────────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow get: if isAuthenticated() && (
        resource == null
        || resource.data.studentId == request.auth.uid
        || ownsClassroom(resource.data.get('classroomId', ''))
        || (assignmentExists(resource.data.assignmentId)
          && ownsClassroom(assignmentData(resource.data.assignmentId).classroomId))
      );
      // list: resource.data is NOT available for collection-level queries.
      allow list: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        && assignmentExists(request.resource.data.assignmentId)
        && request.resource.data.classroomId == assignmentData(request.resource.data.assignmentId).classroomId
        && isEnrolled(request.resource.data.classroomId)
        && (!('deadline' in assignmentData(request.resource.data.assignmentId))
          || assignmentData(request.resource.data.assignmentId).deadline == null
          || request.time < assignmentData(request.resource.data.assignmentId).deadline);
      allow update: if isOwner(resource.data.studentId)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.assignmentId == resource.data.assignmentId
        && assignmentExists(resource.data.assignmentId)
        && request.resource.data.classroomId == assignmentData(resource.data.assignmentId).classroomId
        && isEnrolled(assignmentData(resource.data.assignmentId).classroomId)
        && (!('deadline' in assignmentData(resource.data.assignmentId))
          || assignmentData(resource.data.assignmentId).deadline == null
          || request.time < assignmentData(resource.data.assignmentId).deadline);
      allow delete: if isOwner(resource.data.studentId)
        || (assignmentExists(resource.data.assignmentId)
          && ownsClassroom(assignmentData(resource.data.assignmentId).classroomId));
    }

    // ─── QUESTION BANK ───────────────────────────────────────────────────────
    match /questionBank/{qbId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─── ANNOUNCEMENTS ───────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─── NOTIFICATIONS ───────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow get: if isAuthenticated() && (
        resource == null || resource.data.recipientId == request.auth.uid
      );
      // list: resource.data is NOT available for collection-level queries.
      // Application always filters notifications by recipientId.
      allow list: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string;
      allow update: if isOwner(resource.data.recipientId)
        && request.resource.data.recipientId == resource.data.recipientId;
      allow delete: if isOwner(resource.data.recipientId);
    }

    // ─── DEVICE TRACKING ─────────────────────────────────────────────────────
    match /devices/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }
  }
}
