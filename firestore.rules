rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return userDocExists() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return userDocExists() && getUserData().role == 'student';
    }

    // ─── USERS COLLECTION ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
    }

    // ─── TEACHERS COLLECTION ─────────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId) || (isAuthenticated() && isTeacher());
    }

    // ─── STUDENTS COLLECTION ─────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(studentId);
      allow update, delete: if isOwner(studentId) || (isAuthenticated() && isStudent());
    }

    // ─── CLASSROOMS COLLECTION ───────────────────────────────────────────────
    match /classrooms/{classroomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Allow teacher owner to update/delete, or student to join (update studentIds)
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.teacherId == request.auth.uid;
    }

    // ─── ATTENDANCE SESSIONS ─────────────────────────────────────────────────
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.teacherId == request.auth.uid;
    }

    // ─── ATTENDANCE RECORDS ──────────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }

    // ─── BIOMETRIC FACE DATA ─────────────────────────────────────────────────
    match /faceData/{studentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(studentId) || isAuthenticated();
    }

    // ─── NOTES ───────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─── ASSIGNMENTS ─────────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─── SUBMISSIONS ─────────────────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }

    // ─── QUESTION BANK ───────────────────────────────────────────────────────
    match /questionBank/{qbId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─── ANNOUNCEMENTS ───────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─── DEVICE TRACKING ─────────────────────────────────────────────────────
    match /devices/{userId} {
      allow read, create, update, delete: if isOwner(userId) || isAuthenticated();
    }
  }
}
